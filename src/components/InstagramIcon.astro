---
interface Props {
    class?: string;
}

const { class: className = "size-5" } = Astro.props;
const uid = `ig-${crypto.randomUUID()}`;
---

<svg
    class:list={["shrink-0", className]}
    viewBox="0 0 24 24"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
>
    <defs>
        <radialGradient id={`${uid}-g`} cx="0.3" cy="1.07" r="1.2">
            <stop offset="0" stop-color="#fdf497"></stop>
            <stop offset="0.05" stop-color="#fdf497"></stop>
            <stop offset="0.45" stop-color="#fd5949"></stop>
            <stop offset="0.6" stop-color="#d6249f"></stop>
            <stop offset="0.9" stop-color="#285AEB"></stop>
        </radialGradient>
    </defs>
    <rect width="24" height="24" rx="6.2" fill={`url(#${uid}-g)`}></rect>
    <rect x="6" y="6" width="12" height="12" rx="3.6" stroke="#fff" stroke-width="1.65"></rect>
    <circle cx="12" cy="12" r="2.85" stroke="#fff" stroke-width="1.65"></circle>
    <circle cx="16.35" cy="7.65" r="0.95" fill="#fff"></circle>
</svg>
