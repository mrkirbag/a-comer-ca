---
import { Icon } from "astro-icon/components";
import { site, telHref, waHref } from "../data/site";

const copy = site.contacto;
const form = copy.form;
const address = `${site.contact.address.line}, ${site.contact.address.city}, ${site.contact.address.state}`;
const mapsEmbed = `https://www.google.com/maps?q=${site.contact.address.lat},${site.contact.address.lng}&hl=es&z=18&output=embed`;
const whatsappHref = waHref(site.contact.whatsapp.raw, site.contact.whatsapp.message);
const stars = [5, 4, 3, 2, 1] as const;
---

<section
    id="contacto"
    data-contacto
    class="relative z-20 isolate overflow-x-clip bg-burgundy"
    aria-labelledby="contacto-title"
>
    <div class="contacto-glow" aria-hidden="true"></div>

    <div class="relative mx-auto flex min-h-svh w-full max-w-7xl flex-col justify-center px-5 py-16 lg:px-8 lg:py-16">
        <header class="mx-auto max-w-3xl text-center">
            <p
                data-contacto-copy
                class="inline-flex rounded-full bg-copper px-3 py-1 font-heading text-[10px] font-extrabold tracking-[0.2em] text-grey uppercase"
            >
                {copy.kicker}
            </p>
            <h2
                data-contacto-copy
                id="contacto-title"
                class="mt-2 font-accent text-4xl leading-none text-cream sm:text-5xl"
            >
                {copy.title}
            </h2>
        </header>

        <div class="mt-8 grid items-stretch gap-5 lg:grid-cols-2 lg:gap-6">
            <div data-contacto-info class="flex h-full min-h-0 flex-col gap-3">
                <div class="grid shrink-0 grid-cols-2 gap-3">
                    <a
                        data-contacto-social
                        href={whatsappHref}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex min-h-11 items-center justify-center gap-2 rounded-full bg-cream px-4 py-2.5 font-heading text-sm font-bold tracking-wide text-burgundy transition duration-300 hover:-translate-y-0.5 hover:bg-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cream"
                    >
                        <Icon name="logos:whatsapp-icon" class="size-5" aria-hidden="true" />
                        {copy.whatsappCta}
                    </a>
                    <a
                        data-contacto-social
                        href={site.social.instagram}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex min-h-11 items-center justify-center gap-2 rounded-full bg-cream px-4 py-2.5 font-heading text-sm font-bold tracking-wide text-burgundy transition duration-300 hover:-translate-y-0.5 hover:bg-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cream"
                    >
                        <Icon name="logos:instagram-icon" class="size-5" aria-hidden="true" />
                        {copy.instagramCta}
                    </a>
                </div>

                <figure
                    data-contacto-map
                    class="relative min-h-56 flex-1 overflow-hidden rounded-2xl border border-cream/15 bg-cream/8"
                >
                    <iframe
                        title={`Ubicación de ${site.company.name}: ${address}`}
                        src={mapsEmbed}
                        class="absolute inset-0 h-full w-full border-0"
                        loading="lazy"
                        referrerpolicy="no-referrer-when-downgrade"
                        allowfullscreen
                    ></iframe>
                    <a
                        href={site.contact.address.mapsUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="absolute bottom-3 left-3 z-10 inline-flex items-center rounded-full bg-cream px-3 py-1.5 font-heading text-[10px] font-extrabold tracking-[0.14em] text-burgundy uppercase shadow-[0_8px_20px_rgba(0,0,0,0.25)] transition-colors hover:bg-white"
                    >
                        {copy.mapCta}
                    </a>
                </figure>

                <div class="grid shrink-0 grid-cols-2 gap-3">
                    {
                        site.contact.phones.map((phone) => (
                            <a
                                data-contacto-phone
                                href={telHref(phone.raw)}
                                class="flex min-h-16 flex-col justify-center rounded-2xl border border-cream/15 bg-cream/8 px-4 py-3 transition-colors hover:border-copper hover:bg-cream/12 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cream"
                            >
                                <p class="font-heading text-[10px] font-semibold tracking-[0.18em] text-copper uppercase">
                                    {phone.label}
                                </p>
                                <p class="mt-1 font-heading text-sm font-bold text-cream sm:text-base">
                                    {phone.display}
                                </p>
                            </a>
                        ))
                    }
                </div>
            </div>

            <article
                data-contacto-form
                class="flex h-full flex-col rounded-2xl bg-cream p-5 shadow-[0_16px_36px_rgba(0,0,0,0.28)] sm:p-6"
            >
                <p class="inline-flex w-fit rounded-full bg-olive/60 px-3 py-1 font-heading text-[10px] font-semibold tracking-[0.18em] text-cream uppercase">
                    {form.kicker}
                </p>
                <h3 class="mt-2 font-accent text-2xl leading-none text-burgundy sm:text-3xl">
                    {form.title}
                </h3>

                <form
                    method="POST"
                    action="/.netlify/functions/nueva-opinion"
                    data-opinion-form
                    data-success={form.success}
                    data-error={form.error}
                    data-local={form.localHint}
                    class="mt-4 flex min-h-0 flex-1 flex-col gap-3"
                >
                    <p class="hidden">
                        <label>
                            No llenar <input name="bot-field" tabindex="-1" autocomplete="off" />
                        </label>
                    </p>

                    <label class="block">
                        <span class="font-heading text-xs font-bold tracking-[0.14em] text-burgundy uppercase">
                            {form.nombre}
                        </span>
                        <input
                            type="text"
                            name="nombre"
                            required
                            maxlength="80"
                            autocomplete="name"
                            class="mt-1.5 w-full rounded-xl border border-burgundy/15 bg-white px-3.5 py-2.5 font-sans text-sm text-grey outline-none transition-colors focus:border-burgundy"
                        />
                    </label>

                    <label class="block">
                        <span class="font-heading text-xs font-bold tracking-[0.14em] text-burgundy uppercase">
                            {form.empresa}
                        </span>
                        <input
                            type="text"
                            name="empresa"
                            maxlength="80"
                            autocomplete="organization"
                            class="mt-1.5 w-full rounded-xl border border-burgundy/15 bg-white px-3.5 py-2.5 font-sans text-sm text-grey outline-none transition-colors focus:border-burgundy"
                        />
                    </label>

                    <fieldset>
                        <legend class="font-heading text-xs font-bold tracking-[0.14em] text-burgundy uppercase">
                            {form.estrellas}
                        </legend>
                        <div class="star-rating mt-2 flex flex-row-reverse justify-end gap-1">
                            {
                                stars.map((value, index) => (
                                    <>
                                        <input
                                            class="peer sr-only"
                                            type="radio"
                                            name="estrellas"
                                            id={`estrella-${value}`}
                                            value={value}
                                            required={index === stars.length - 1}
                                            checked={value === 5}
                                        />
                                        <label
                                            for={`estrella-${value}`}
                                            class="cursor-pointer transition-colors"
                                        >
                                            <span class="sr-only">{value} estrellas</span>
                                            <svg class="size-7" viewBox="0 0 24 24" aria-hidden="true">
                                                <path
                                                    fill="currentColor"
                                                    d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.62L12 2 9.19 8.62 2 9.24l5.46 4.73L5.82 21z"
                                                />
                                            </svg>
                                        </label>
                                    </>
                                ))
                            }
                        </div>
                    </fieldset>

                    <label class="flex min-h-0 flex-1 flex-col">
                        <span class="font-heading text-xs font-bold tracking-[0.14em] text-burgundy uppercase">
                            {form.texto}
                        </span>
                        <textarea
                            name="texto"
                            required
                            maxlength="600"
                            rows="4"
                            class="mt-1.5 min-h-24 w-full flex-1 resize-none rounded-xl border border-burgundy/15 bg-white px-3.5 py-2.5 font-sans text-sm text-grey outline-none transition-colors focus:border-burgundy"
                        ></textarea>
                    </label>

                    <p
                        data-form-status
                        class="hidden font-sans text-sm leading-relaxed"
                        role="status"
                    ></p>

                    <button
                        type="submit"
                        data-form-submit
                        class="inline-flex min-h-11 w-full shrink-0 items-center justify-center gap-2 rounded-full bg-burgundy px-7 py-2.5 font-heading text-sm font-bold tracking-wide text-cream transition-colors hover:bg-burgundy/85 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-burgundy disabled:opacity-60"
                    >
                        <svg class="size-4" viewBox="0 0 24 24" aria-hidden="true">
                            <path fill="currentColor" d="M2 21 23 12 2 3v7l15 2-15 2z" />
                        </svg>
                        {form.submit}
                    </button>
                </form>
            </article>
        </div>
    </div>
</section>

<style>
    [data-contacto]:not([data-ready]) :is(
        [data-contacto-copy],
        [data-contacto-social],
        [data-contacto-map],
        [data-contacto-phone],
        [data-contacto-form]
    ) {
        visibility: hidden;
    }

    .contacto-glow {
        pointer-events: none;
        position: absolute;
        inset: 0;
        background:
            radial-gradient(ellipse 70% 55% at 8% 90%, rgb(192 138 124 / 0.28), transparent 58%),
            radial-gradient(ellipse 45% 40% at 96% 8%, rgb(88 105 76 / 0.35), transparent 52%);
    }

    .star-rating label {
        color: rgb(122 0 16 / 0.18);
    }

    .star-rating label:hover,
    .star-rating label:hover ~ label,
    .star-rating input:checked ~ label {
        color: var(--color-copper);
    }
</style>

<script>
    import gsap from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    function initContactoMotion() {
        const root = document.querySelector("[data-contacto]");
        if (!(root instanceof HTMLElement) || root.dataset.ready === "true") return;

        const copy = root.querySelectorAll("[data-contacto-copy]");
        const socials = root.querySelectorAll("[data-contacto-social]");
        const map = root.querySelector("[data-contacto-map]");
        const phones = root.querySelectorAll("[data-contacto-phone]");
        const formCard = root.querySelector("[data-contacto-form]");

        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
            root.dataset.ready = "true";
            return;
        }

        const setFrom = (dir: number) => {
            gsap.set(copy, { y: 24 * dir, opacity: 0 });
            gsap.set(socials, { y: 20 * dir, opacity: 0, scale: 0.92 });
            gsap.set(map, { y: 28 * dir, opacity: 0, scale: 0.97 });
            gsap.set(phones, { y: 20 * dir, opacity: 0 });
            gsap.set(formCard, { x: 32 * dir, opacity: 0 });
        };

        const tl = gsap.timeline({
            paused: true,
            defaults: { ease: "power3.out" },
        });

        tl.to(copy, { y: 0, opacity: 1, duration: 0.65, stagger: 0.08 }, 0)
            .to(socials, { y: 0, opacity: 1, scale: 1, duration: 0.55, stagger: 0.08, ease: "back.out(1.5)" }, 0.12)
            .to(map, { y: 0, opacity: 1, scale: 1, duration: 0.8 }, 0.22)
            .to(phones, { y: 0, opacity: 1, duration: 0.55, stagger: 0.08 }, 0.32)
            .to(formCard, { x: 0, opacity: 1, duration: 0.85 }, 0.18);

        const play = (dir: number) => {
            tl.pause(0);
            setFrom(dir);
            tl.invalidate().restart();
        };

        setFrom(1);
        root.dataset.ready = "true";

        ScrollTrigger.create({
            trigger: root,
            start: "top 78%",
            end: "bottom top",
            onEnter: () => play(1),
            onEnterBack: () => play(-1),
            onLeave: () => tl.reverse(),
            onLeaveBack: () => tl.reverse(),
        });
    }

    function initOpinionForm() {
        const form = document.querySelector("[data-opinion-form]");
        const status = document.querySelector("[data-form-status]");
        if (!(form instanceof HTMLFormElement) || !(status instanceof HTMLElement)) return;
        if (form.dataset.bound === "true") return;
        form.dataset.bound = "true";

        const isLocal =
            window.location.hostname === "localhost" || window.location.hostname === "127.0.0.1";

        const submit = form.querySelector("[data-form-submit]");

        form.addEventListener("submit", async (event) => {
            event.preventDefault();

            if (isLocal) {
                status.classList.remove("hidden", "text-burgundy");
                status.classList.add("text-olive");
                status.textContent = form.dataset.local ?? "";
                return;
            }

            status.classList.add("hidden");
            if (submit instanceof HTMLButtonElement) submit.disabled = true;

            try {
                const fields = Object.fromEntries(
                    [...new FormData(form).entries()].filter(
                        (entry): entry is [string, string] => typeof entry[1] === "string",
                    ),
                );

                const response = await fetch("/.netlify/functions/nueva-opinion", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(fields),
                });
                const payload = await response.json().catch(() => ({}));
                if (!response.ok || payload.ok !== true) {
                    console.error("nueva-opinion", response.status, payload);
                    throw new Error("form");
                }

                form.reset();
                const five = form.querySelector<HTMLInputElement>("#estrella-5");
                if (five) five.checked = true;
                status.classList.remove("hidden", "text-burgundy");
                status.classList.add("text-olive");
                status.textContent = form.dataset.success ?? "";
            } catch {
                status.classList.remove("hidden", "text-olive");
                status.classList.add("text-burgundy");
                status.textContent = form.dataset.error ?? "";
            } finally {
                if (submit instanceof HTMLButtonElement) submit.disabled = false;
            }
        });
    }

    initContactoMotion();
    initOpinionForm();
    document.addEventListener("astro:page-load", () => {
        initContactoMotion();
        initOpinionForm();
    });
</script>
