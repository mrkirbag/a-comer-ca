---
import { getCollection } from "astro:content";
import { site } from "../data/site";

const { kicker, title, subtitle, empty, cta, ctaHref } = site.opiniones;

const opiniones = (await getCollection("opiniones"))
    .filter((entry) => entry.data.aprobada)
    .sort((a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf());

function formatFecha(fecha: Date) {
    return fecha.toLocaleDateString("es-VE", { month: "long", year: "numeric" });
}
---

<section id="opiniones" data-opiniones class="relative z-20 bg-cream" aria-labelledby="opiniones-title">
    <div class="mx-auto max-w-7xl px-5 py-24 lg:px-8 lg:py-32">
        <header data-opiniones-header class="mx-auto max-w-3xl text-center">
            <p
                data-opiniones-copy
                class="inline-flex rounded-full bg-olive/60 px-4 py-1.5 font-heading text-xs font-semibold tracking-[0.2em] text-cream uppercase"
            >
                {kicker}
            </p>
            <h2
                data-opiniones-copy
                id="opiniones-title"
                class="mt-3 font-accent text-5xl leading-none text-burgundy sm:text-6xl md:text-7xl"
            >
                {title}
            </h2>
            <span data-opiniones-copy class="mx-auto mt-5 flex items-center justify-center gap-2" aria-hidden="true">
                <span class="h-px w-8 bg-copper/50"></span>
                <span class="size-1.5 rotate-45 bg-copper"></span>
                <span class="h-px w-8 bg-copper/50"></span>
            </span>
            <p
                data-opiniones-copy
                class="mx-auto mt-5 max-w-2xl font-heading text-base font-bold leading-snug text-balance text-burgundy/80 sm:text-lg"
            >
                {subtitle}
            </p>
        </header>

        {
            opiniones.length === 0 ? (
                <div data-opiniones-empty class="mx-auto mt-16 max-w-xl rounded-3xl border border-burgundy/10 bg-white/50 p-8 text-center lg:mt-24">
                    <p class="font-sans text-base leading-relaxed text-grey/80">{empty}</p>
                    <a
                        href={ctaHref}
                        class="mt-6 inline-flex min-w-44 items-center justify-center rounded-full bg-burgundy px-8 py-3 font-heading text-sm font-bold tracking-wide text-cream transition-colors hover:bg-burgundy/85 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-burgundy"
                    >
                        {cta}
                    </a>
                </div>
            ) : (
                <ul class="mt-16 grid gap-5 md:grid-cols-2 lg:mt-24 lg:grid-cols-3 lg:gap-6">
                    {opiniones.map((opinion) => (
                        <li data-opiniones-card>
                            <article class="flex h-full flex-col rounded-3xl border border-burgundy/10 bg-white/50 p-7 transition-shadow duration-300 hover:shadow-[0_16px_40px_rgba(122,0,16,0.14)] lg:p-8">
                                <svg class="size-8 text-copper" viewBox="0 0 24 24" aria-hidden="true">
                                    <path
                                        fill="currentColor"
                                        d="M14 17h3V6h-5v7.5c0 1.93 1.57 3.5 3.5 3.5zm-8 0h3V6H4v7.5C4 15.43 5.57 17 7.5 17z"
                                    />
                                </svg>
                                <p class="mt-4 flex-1 font-sans text-base leading-relaxed text-grey/80">
                                    {opinion.body?.trim()}
                                </p>
                                <div
                                    class="mt-5 flex gap-0.5 text-copper"
                                    aria-label={`${opinion.data.estrellas} de 5 estrellas`}
                                >
                                    {Array.from({ length: 5 }, (_, index) => (
                                        <svg
                                            class:list={[
                                                "size-5",
                                                index < opinion.data.estrellas
                                                    ? "text-copper"
                                                    : "text-burgundy/15",
                                            ]}
                                            viewBox="0 0 24 24"
                                            aria-hidden="true"
                                        >
                                            <path
                                                fill="currentColor"
                                                d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.62L12 2 9.19 8.62 2 9.24l5.46 4.73L5.82 21z"
                                            />
                                        </svg>
                                    ))}
                                </div>
                                <p class="mt-4 font-heading text-lg font-bold text-burgundy">
                                    {opinion.data.nombre}
                                </p>
                                {opinion.data.empresa ? (
                                    <p class="font-heading text-sm font-semibold tracking-wide text-olive">
                                        {opinion.data.empresa}
                                    </p>
                                ) : null}
                                <p class="mt-1 font-sans text-xs capitalize text-grey/50">
                                    {formatFecha(opinion.data.fecha)}
                                </p>
                            </article>
                        </li>
                    ))}
                </ul>
            )
        }

        {
            opiniones.length > 0 ? (
                <div data-opiniones-cta class="mt-12 text-center lg:mt-16">
                    <a
                        href={ctaHref}
                        class="inline-flex min-w-44 items-center justify-center rounded-full bg-burgundy px-8 py-3 font-heading text-sm font-bold tracking-wide text-cream transition-colors hover:bg-burgundy/85 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-burgundy"
                    >
                        {cta}
                    </a>
                </div>
            ) : null
        }
    </div>
</section>

<style>
    [data-opiniones]:not([data-ready]) :is(
        [data-opiniones-copy],
        [data-opiniones-card],
        [data-opiniones-empty],
        [data-opiniones-cta]
    ) {
        visibility: hidden;
    }
</style>

<script>
    import gsap from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    function initOpiniones() {
        const root = document.querySelector("[data-opiniones]");
        if (!(root instanceof HTMLElement) || root.dataset.ready === "true") return;

        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
            root.dataset.ready = "true";
            return;
        }

        const copy = root.querySelectorAll("[data-opiniones-copy]");
        const cards = root.querySelectorAll("[data-opiniones-card]");
        const empty = root.querySelector("[data-opiniones-empty]");
        const cta = root.querySelector("[data-opiniones-cta]");

        gsap.set(copy, { y: 24, opacity: 0 });
        if (cards.length) gsap.set(cards, { y: 32, opacity: 0, scale: 0.97 });
        if (empty) gsap.set(empty, { y: 24, opacity: 0 });
        if (cta) gsap.set(cta, { y: 16, opacity: 0 });

        root.dataset.ready = "true";

        const tl = gsap.timeline({
            defaults: { ease: "power3.out" },
            scrollTrigger: {
                trigger: root,
                start: "top 72%",
            },
        });

        tl.to(copy, { y: 0, opacity: 1, duration: 0.7, stagger: 0.08 });
        if (cards.length) {
            tl.to(cards, { y: 0, opacity: 1, scale: 1, duration: 0.7, stagger: 0.1 }, 0.22);
        }
        if (empty) tl.to(empty, { y: 0, opacity: 1, duration: 0.6 }, 0.2);
        if (cta) tl.to(cta, { y: 0, opacity: 1, duration: 0.5 }, 0.45);
    }

    initOpiniones();
    document.addEventListener("astro:page-load", initOpiniones);
</script>
