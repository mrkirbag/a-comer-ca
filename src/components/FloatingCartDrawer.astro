---
import { site } from "../data/site";

interface Props {
    whatsappNumber?: string;
}

const { whatsappNumber = site.contact.whatsapp.raw } = Astro.props;
---

<!-- Floating Cart Trigger Button -->
<button
    id="cart-trigger-btn"
    type="button"
    aria-label="Ver solicitud de catálogo"
    class="fixed bottom-6 right-6 z-50 flex items-center gap-3 rounded-full bg-burgundy px-5 py-3.5 text-cream shadow-2xl transition-all duration-300 hover:scale-105 hover:bg-burgundy/90 hover:shadow-[0_20px_45px_rgba(122,0,16,0.35)] focus:outline-none focus:ring-4 focus:ring-copper/40 cursor-pointer"
>
    <div class="relative flex items-center justify-center">
        <svg class="size-6 text-cream" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"></path>
            <path d="M3 6h18"></path>
            <path d="M16 10a4 4 0 0 1-8 0"></path>
        </svg>
        <span
            id="cart-count-badge"
            class="absolute -top-2.5 -right-2.5 flex h-5 min-w-[1.25rem] items-center justify-center rounded-full bg-copper px-1.5 font-heading text-xs font-bold text-burgundy shadow-sm transition-transform duration-200 scale-0"
        >
            0
        </span>
    </div>
    <span class="font-heading text-sm font-bold tracking-wide">
        Mi Lista <span id="cart-btn-label" class="hidden sm:inline font-normal text-cream/80">(0 items)</span>
    </span>
</button>

<!-- Cart Drawer Modal Backdrop & Aside -->
<div
    id="cart-drawer-backdrop"
    class="fixed inset-0 z-50 bg-black/60 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300"
    aria-hidden="true"
></div>

<aside
    id="cart-drawer"
    role="dialog"
    aria-label="Lista de consulta de productos"
    aria-modal="true"
    class="fixed inset-y-0 right-0 z-50 flex w-full max-w-md flex-col bg-cream shadow-2xl transition-transform duration-300 ease-out translate-x-full border-l border-burgundy/15"
>
    <!-- Header -->
    <div class="flex items-center justify-between border-b border-burgundy/10 bg-white/70 px-6 py-5 backdrop-blur-md">
        <div class="flex items-center gap-3">
            <div class="flex size-10 items-center justify-center rounded-2xl bg-burgundy/10 text-burgundy">
                <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"></path>
                    <path d="M3 6h18"></path>
                    <path d="M16 10a4 4 0 0 1-8 0"></path>
                </svg>
            </div>
            <div>
                <h2 class="font-heading text-lg font-bold text-burgundy leading-tight">Lista de Pedido</h2>
                <p class="font-sans text-xs text-grey/70">Confirmación de existencia & asesoría</p>
            </div>
        </div>

        <button
            id="close-cart-btn"
            type="button"
            aria-label="Cerrar lista"
            class="flex size-9 items-center justify-center rounded-full text-burgundy/60 hover:bg-burgundy/10 hover:text-burgundy transition-colors"
        >
            <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 6 6 18"></path>
                <path d="m6 6 12 12"></path>
            </svg>
        </button>
    </div>

    <!-- Info Banner (No prices, editorial catalog style) -->
    <div class="bg-olive/10 border-b border-olive/20 px-6 py-3 flex items-start gap-3">
        <svg class="size-5 text-olive shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="16" x2="12" y2="12"></line>
            <line x1="12" y1="8" x2="12.01" y2="8"></line>
        </svg>
        <p class="font-sans text-xs text-olive/90 leading-relaxed">
            <strong>Modalidad Revista:</strong> Selecciona los productos de tu interés. Al enviar la lista por WhatsApp, nuestro equipo confirmará existencias, presentaciones exactas y coordinará los métodos de pago.
        </p>
    </div>

    <!-- Items List Container -->
    <div id="cart-items-container" class="flex-1 overflow-y-auto px-6 py-4 space-y-3">
        <!-- Rendered via JS -->
    </div>

    <!-- Empty State -->
    <div id="cart-empty-state" class="hidden flex-1 flex-col items-center justify-center p-8 text-center">
        <div class="mb-4 flex size-20 items-center justify-center rounded-3xl bg-burgundy/5 text-burgundy/30">
            <svg class="size-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"></path>
                <path d="M3 6h18"></path>
                <path d="M16 10a4 4 0 0 1-8 0"></path>
            </svg>
        </div>
        <h3 class="font-heading text-lg font-bold text-burgundy">Tu lista está vacía</h3>
        <p class="mt-1 font-sans text-sm text-grey/70 max-w-xs">
            Navega por nuestro catálogo tipo revista y añade los artículos que desees consultar.
        </p>
    </div>

    <!-- Footer Actions & WhatsApp Send -->
    <div class="border-t border-burgundy/10 bg-white/80 p-6 backdrop-blur-md space-y-4">
        <!-- Optional User Info Form -->
        <div class="space-y-2">
            <label for="cart-customer-name" class="block font-heading text-xs font-semibold uppercase tracking-wider text-burgundy/80">
                Tu Nombre o Negocio (Opcional):
            </label>
            <input
                type="text"
                id="cart-customer-name"
                placeholder="Ej. Panadería El Trigo / María Pérez"
                class="w-full rounded-xl border border-burgundy/15 bg-white px-3.5 py-2 font-sans text-sm text-burgundy placeholder:text-grey/40 focus:border-burgundy focus:outline-none focus:ring-2 focus:ring-burgundy/10"
            />
        </div>

        <div class="flex items-center justify-between text-xs font-heading font-medium text-grey/70">
            <span>Productos seleccionados:</span>
            <span id="cart-total-qty" class="font-bold text-burgundy">0 unidades</span>
        </div>

        <button
            id="cart-whatsapp-btn"
            type="button"
            class="w-full flex items-center justify-center gap-2.5 rounded-2xl bg-[#25D366] px-5 py-3.5 font-heading text-base font-bold text-white shadow-lg transition-all duration-200 hover:bg-[#20ba59] hover:shadow-[0_8px_25px_rgba(37,211,102,0.35)] disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer"
        >
            <svg class="size-5 fill-current" viewBox="0 0 24 24">
                <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
            </svg>
            <span>Consultar Disponibilidad</span>
        </button>

        <button
            id="clear-cart-btn"
            type="button"
            class="w-full text-center font-heading text-xs text-grey/50 hover:text-burgundy transition-colors py-1 cursor-pointer"
        >
            Vaciar lista
        </button>
    </div>
</aside>

<script is:inline define:vars={{ whatsappNumber }}>
    // Cart Global State Manager
    const STORAGE_KEY = "acomer_cart_items";

    function getCart() {
        try {
            const raw = localStorage.getItem(STORAGE_KEY);
            return raw ? JSON.parse(raw) : [];
        } catch {
            return [];
        }
    }

    function saveCart(items) {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(items));
        renderCartUI();
        window.dispatchEvent(new CustomEvent("cart-updated", { detail: { items } }));
    }

    window.addToCatalogCart = function(product, qty = 1) {
        const cart = getCart();
        const existing = cart.find(i => i.id === product.id);
        if (existing) {
            existing.qty += qty;
        } else {
            cart.push({
                id: product.id,
                name: product.name,
                brand: product.brand || "",
                category: product.category || "",
                subCategory: product.subCategory || "",
                image: product.image || "",
                presentation: product.presentation || "",
                qty: qty
            });
        }
        saveCart(cart);
        openCartDrawer();
    };

    function updateItemQty(id, delta) {
        let cart = getCart();
        const item = cart.find(i => i.id === id);
        if (!item) return;
        item.qty += delta;
        if (item.qty <= 0) {
            cart = cart.filter(i => i.id !== id);
        }
        saveCart(cart);
    }

    function removeItem(id) {
        let cart = getCart().filter(i => i.id !== id);
        saveCart(cart);
    }

    // Drawer Visibility
    const drawer = document.getElementById("cart-drawer");
    const backdrop = document.getElementById("cart-drawer-backdrop");
    const triggerBtn = document.getElementById("cart-trigger-btn");
    const closeBtn = document.getElementById("close-cart-btn");
    const emptyState = document.getElementById("cart-empty-state");
    const itemsContainer = document.getElementById("cart-items-container");
    const countBadge = document.getElementById("cart-count-badge");
    const cartBtnLabel = document.getElementById("cart-btn-label");
    const totalQtySpan = document.getElementById("cart-total-qty");
    const whatsappBtn = document.getElementById("cart-whatsapp-btn");
    const clearBtn = document.getElementById("clear-cart-btn");
    const customerNameInput = document.getElementById("cart-customer-name");

    function openCartDrawer() {
        drawer.classList.remove("translate-x-full");
        backdrop.classList.remove("opacity-0", "pointer-events-none");
        backdrop.classList.add("opacity-100");
        document.body.style.overflow = "hidden";
    }

    function closeCartDrawer() {
        drawer.classList.add("translate-x-full");
        backdrop.classList.remove("opacity-100");
        backdrop.classList.add("opacity-0", "pointer-events-none");
        document.body.style.overflow = "";
    }

    triggerBtn?.addEventListener("click", openCartDrawer);
    closeBtn?.addEventListener("click", closeCartDrawer);
    backdrop?.addEventListener("click", closeCartDrawer);

    clearBtn?.addEventListener("click", () => {
        if (confirm("¿Deseas vaciar tu lista de productos?")) {
            saveCart([]);
        }
    });

    function renderCartUI() {
        const cart = getCart();
        const totalItems = cart.reduce((acc, item) => acc + item.qty, 0);

        // Update badge
        if (countBadge) {
            countBadge.textContent = totalItems;
            if (totalItems > 0) {
                countBadge.classList.remove("scale-0");
                countBadge.classList.add("scale-100");
            } else {
                countBadge.classList.remove("scale-100");
                countBadge.classList.add("scale-0");
            }
        }

        if (cartBtnLabel) {
            cartBtnLabel.textContent = `(${totalItems} ${totalItems === 1 ? 'item' : 'items'})`;
        }

        if (totalQtySpan) {
            totalQtySpan.textContent = `${totalItems} ${totalItems === 1 ? 'unidad' : 'unidades'}`;
        }

        if (whatsappBtn) {
            whatsappBtn.disabled = totalItems === 0;
        }

        if (totalItems === 0) {
            emptyState?.classList.remove("hidden");
            emptyState?.classList.add("flex");
            if (itemsContainer) itemsContainer.innerHTML = "";
            return;
        }

        emptyState?.classList.add("hidden");
        emptyState?.classList.remove("flex");

        if (!itemsContainer) return;

        itemsContainer.innerHTML = cart.map(item => `
            <div class="flex items-center gap-3.5 rounded-2xl border border-burgundy/10 bg-white p-3.5 shadow-sm transition-all">
                <div class="size-16 shrink-0 overflow-hidden rounded-xl bg-cream/50 border border-burgundy/5 flex items-center justify-center p-1.5">
                    ${item.image ? `<img src="${item.image}" alt="${item.name}" class="h-full w-full object-contain" />` : `<span class="font-heading text-lg font-bold text-burgundy/40">${item.name.charAt(0)}</span>`}
                </div>
                <div class="flex-1 min-w-0">
                    <p class="font-heading text-xs font-semibold text-olive uppercase tracking-wider line-clamp-1">${item.brand || item.subCategory || 'A-Comer'}</p>
                    <h4 class="font-heading text-sm font-bold text-burgundy truncate">${item.name}</h4>
                    ${item.presentation ? `<p class="font-sans text-[11px] text-grey/60 truncate mt-0.5">${item.presentation}</p>` : ''}
                    <div class="mt-2 flex items-center gap-2">
                        <div class="inline-flex items-center rounded-lg border border-burgundy/15 bg-cream/40">
                            <button type="button" onclick="window.changeCartQty('${item.id}', -1)" class="px-2 py-0.5 text-xs font-bold text-burgundy hover:bg-burgundy/10 rounded-l-lg transition-colors cursor-pointer">−</button>
                            <span class="px-2 font-heading text-xs font-bold text-burgundy">${item.qty}</span>
                            <button type="button" onclick="window.changeCartQty('${item.id}', 1)" class="px-2 py-0.5 text-xs font-bold text-burgundy hover:bg-burgundy/10 rounded-r-lg transition-colors cursor-pointer">+</button>
                        </div>
                    </div>
                </div>
                <button type="button" onclick="window.removeCartItem('${item.id}')" aria-label="Eliminar" class="p-1.5 text-burgundy/40 hover:text-burgundy transition-colors rounded-lg hover:bg-burgundy/5 cursor-pointer">
                    <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M3 6h18"></path>
                        <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path>
                        <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path>
                    </svg>
                </button>
            </div>
        `).join("");
    }

    window.changeCartQty = updateItemQty;
    window.removeCartItem = removeItem;

    // Send WhatsApp Order / Inquiry
    whatsappBtn?.addEventListener("click", () => {
        const cart = getCart();
        if (cart.length === 0) return;

        const customerName = customerNameInput?.value.trim();
        let message = `*SOLICITUD DE CATÁLOGO / COTIZACIÓN — A-COMER C.A.*\n`;
        message += `-------------------------------------------\n`;
        if (customerName) {
            message += `*Cliente / Negocio:* ${customerName}\n`;
        }
        message += `*Fecha:* ${new Date().toLocaleDateString('es-VE')}\n\n`;
        message += `Hola, estuve revisando su catálogo revista y me gustaría confirmar existencia, detalles y coordinar la compra de los siguientes productos:\n\n`;

        cart.forEach((item, index) => {
            message += `*${index + 1}. ${item.name}*\n`;
            message += `   • Cantidad solicitada: ${item.qty} ${item.qty === 1 ? 'unidad' : 'unidades'}\n`;
            if (item.brand) message += `   • Marca: ${item.brand}\n`;
            if (item.presentation) message += `   • Presentación: ${item.presentation}\n`;
            message += `\n`;
        });

        message += `-------------------------------------------\n`;
        message += `Quedo atento(a) a la confirmación de stock, opciones de presentación y formas de pago. ¡Gracias!`;

        const encoded = encodeURIComponent(message);
        const url = `https://wa.me/${whatsappNumber}?text=${encoded}`;
        window.open(url, "_blank");
    });

    // Initial render
    document.addEventListener("DOMContentLoaded", () => {
        renderCartUI();
    });
    renderCartUI();
</script>
