---
import { site } from "../data/site";

const { kicker, title, subtitle, bandaIzquierda, bandaDerecha } = site.aliados;
const loops = 3;
---

<section id="aliados" data-aliados class="relative z-20 overflow-x-clip bg-cream" aria-labelledby="aliados-title">
    <div class="mx-auto max-w-7xl px-5 pt-14 pb-8 text-center lg:px-8 lg:pt-16 lg:pb-10">
        <p
            data-aliados-copy
            class="inline-flex rounded-full bg-olive/60 px-4 py-1.5 font-heading text-xs font-semibold tracking-[0.2em] text-cream uppercase"
        >
            {kicker}
        </p>
        <h2
            data-aliados-copy
            id="aliados-title"
            class="mt-3 font-accent text-4xl leading-none text-burgundy sm:text-5xl md:text-6xl"
        >
            {title}
        </h2>
        <p
            data-aliados-copy
            class="mx-auto mt-4 max-w-2xl font-heading text-base font-bold leading-snug text-balance text-burgundy/80 sm:text-lg"
        >
            {subtitle}
        </p>
    </div>

    <div class="flex flex-col gap-16 pb-14 lg:gap-20 lg:pb-16">
        <div data-aliados-band class="aliados-band" aria-hidden="true">
            <ul class="aliados-track aliados-track--left">
                {
                    Array.from({ length: loops }, () => bandaIzquierda)
                        .flat()
                        .map((nombre) => (
                            <li class="aliados-item">
                                <span class="aliados-name">{nombre}</span>
                                <span class="aliados-dot"></span>
                            </li>
                        ))
                }
            </ul>
        </div>

        <div data-aliados-band class="aliados-band" aria-hidden="true">
            <ul class="aliados-track aliados-track--right">
                {
                    Array.from({ length: loops }, () => bandaDerecha)
                        .flat()
                        .map((nombre) => (
                            <li class="aliados-item">
                                <span class="aliados-name">{nombre}</span>
                                <span class="aliados-dot"></span>
                            </li>
                        ))
                }
            </ul>
        </div>
    </div>

    <ul class="sr-only">
        {[...bandaIzquierda, ...bandaDerecha].map((nombre) => (
            <li>{nombre}</li>
        ))}
    </ul>
</section>

<style>
    [data-aliados]:not([data-ready]) :is([data-aliados-copy], [data-aliados-band]) {
        visibility: hidden;
    }

    .aliados-band {
        overflow: hidden;
        background: #fff;
        padding-block: 1.15rem;
        mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    }

    .aliados-track {
        display: flex;
        width: max-content;
        align-items: center;
        gap: 0;
    }

    .aliados-item {
        display: flex;
        flex-shrink: 0;
        align-items: center;
        gap: 3.25rem;
        padding-inline: 1.625rem;
    }

    .aliados-name {
        font-family: var(--font-heading);
        font-size: clamp(0.72rem, 1.15vw, 0.88rem);
        font-weight: 600;
        letter-spacing: 0.16em;
        white-space: nowrap;
        color: var(--color-grey);
        text-transform: uppercase;
    }

    .aliados-dot {
        width: 0.4rem;
        height: 0.4rem;
        rotate: 45deg;
        background: var(--color-copper);
    }

    .aliados-track--left {
        animation: aliados-marquee 42s linear infinite;
    }

    .aliados-track--right {
        animation: aliados-marquee 48s linear infinite reverse;
    }

    .aliados-band:hover .aliados-track {
        animation-play-state: paused;
    }

    @keyframes aliados-marquee {
        from {
            transform: translateX(0);
        }
        to {
            transform: translateX(-33.333%);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .aliados-track--left,
        .aliados-track--right {
            animation: none;
        }
    }
</style>

<script>
    import gsap from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    function initAliados() {
        const root = document.querySelector("[data-aliados]");
        if (!(root instanceof HTMLElement) || root.dataset.ready === "true") return;

        const copy = root.querySelectorAll("[data-aliados-copy]");
        const bands = root.querySelectorAll("[data-aliados-band]");

        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
            root.dataset.ready = "true";
            return;
        }

        const setFrom = (dir: number) => {
            gsap.set(copy, { y: 20 * dir, opacity: 0 });
            gsap.set(bands, { y: 16 * dir, opacity: 0 });
        };

        const tl = gsap.timeline({
            paused: true,
            defaults: { ease: "power3.out" },
        });

        tl.to(copy, { y: 0, opacity: 1, duration: 0.65, stagger: 0.08 }, 0).to(
            bands,
            { y: 0, opacity: 1, duration: 0.7, stagger: 0.1 },
            0.16,
        );

        const play = (dir: number) => {
            tl.pause(0);
            setFrom(dir);
            tl.invalidate().restart();
        };

        setFrom(1);
        root.dataset.ready = "true";

        ScrollTrigger.create({
            trigger: root,
            start: "top 82%",
            end: "bottom top",
            onEnter: () => play(1),
            onEnterBack: () => play(-1),
            onLeave: () => tl.reverse(),
            onLeaveBack: () => tl.reverse(),
        });
    }

    initAliados();
    document.addEventListener("astro:page-load", initAliados);
</script>
