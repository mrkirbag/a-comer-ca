---
import { Icon } from "astro-icon/components";
import { site, waHref } from "../data/site";

const { kicker, title, highlight, body, examples, cta, whatsappMessage, image, imageAlt, badge } =
    site.services;
const whatsappHref = waHref(site.contact.whatsapp.raw, whatsappMessage);

const exampleIcons = [
    "M11 9H9V2H7v7H5V2H3v7c0 2.12 1.66 3.84 3.75 3.97V22h2.5v-9.03C11.34 12.84 13 11.12 13 9V2h-2zm5-3v8h2.5v8H21V2c-2.76 0-5 2.24-5 4",
    "M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5s-3 1.34-3 3 1.34 3 3 3m-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5 5 6.34 5 8s1.34 3 3 3m0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5C15 14.17 10.33 13 8 13m8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5",
] as const;
---

<section
    id="servicios"
    data-services
    class="relative z-20 isolate overflow-hidden bg-burgundy"
    aria-labelledby="servicios-title"
>
    <div class="services-glow" aria-hidden="true"></div>

    <div class="relative mx-auto grid max-w-7xl items-center gap-8 px-5 py-16 lg:grid-cols-2 lg:gap-12 lg:px-8 lg:py-20">
        <div data-services-visual class="relative">
            <div
                data-services-frame
                class="absolute -inset-2 translate-x-2 translate-y-2 rounded-3xl bg-copper/40"
                aria-hidden="true"
            >
            </div>
            <figure class="relative overflow-hidden rounded-3xl shadow-[0_20px_48px_rgba(0,0,0,0.3)]">
                <img
                    data-services-photo
                    src={image}
                    alt={imageAlt}
                    class="aspect-4/3 h-full w-full object-cover object-center"
                    width="800"
                    height="600"
                    loading="lazy"
                    decoding="async"
                />
                <div
                    class="pointer-events-none absolute inset-0 bg-linear-to-t from-burgundy/50 via-transparent to-transparent"
                >
                </div>
                <p
                    data-services-badge
                    class="absolute bottom-4 left-4 rounded-full bg-cream px-3 py-1.5 font-heading text-[10px] font-extrabold tracking-[0.16em] text-burgundy uppercase"
                >
                    {badge}
                </p>
            </figure>
        </div>

        <div>
            <p
                data-services-copy
                class="inline-flex rounded-full bg-copper px-4 py-1.5 font-heading text-xs font-extrabold tracking-[0.2em] text-grey uppercase"
            >
                {kicker}
            </p>
            <h2
                data-services-copy
                id="servicios-title"
                class="mt-3 font-accent text-4xl leading-none text-cream sm:text-5xl"
            >
                {title}
            </h2>
            <p
                data-services-copy
                class="mt-3 font-heading text-lg font-bold text-copper sm:text-xl"
            >
                {highlight}
            </p>
            <p data-services-copy class="mt-4 font-sans text-base leading-relaxed text-white/85">
                {body}
            </p>

            <ul class="mt-5 grid gap-3 sm:grid-cols-2">
                {
                    examples.map((example, index) => (
                        <li data-services-card>
                            <article class="h-full rounded-2xl border border-cream/15 bg-cream/8 p-4">
                                <span class="flex size-9 items-center justify-center rounded-full bg-copper text-burgundy">
                                    <svg class="size-5" viewBox="0 0 24 24" aria-hidden="true">
                                        <path fill="currentColor" d={exampleIcons[index]} />
                                    </svg>
                                </span>
                                <h3 class="mt-3 font-heading text-sm font-bold text-cream">
                                    {example.title}
                                </h3>
                                <p class="mt-1 font-sans text-sm leading-relaxed text-cream/75">
                                    {example.body}
                                </p>
                            </article>
                        </li>
                    ))
                }
            </ul>

            <div data-services-cta class="mt-6">
                <a
                    href={whatsappHref}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="services-cta inline-flex min-w-44 items-center justify-center gap-2 rounded-full bg-cream px-8 py-3 font-heading text-sm font-bold tracking-wide text-burgundy transition duration-300 hover:-translate-y-0.5 hover:bg-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cream"
                >
                    <Icon name="logos:whatsapp-icon" class="size-5" aria-hidden="true" />
                    {cta}
                </a>
            </div>
        </div>
    </div>
</section>

<style>
    [data-services]:not([data-ready]) :is(
        [data-services-copy],
        [data-services-visual],
        [data-services-card],
        [data-services-cta],
        [data-services-badge]
    ) {
        visibility: hidden;
    }

    .services-glow {
        pointer-events: none;
        position: absolute;
        inset: 0;
        background:
            radial-gradient(ellipse 70% 55% at 8% 90%, rgb(192 138 124 / 0.28), transparent 58%),
            radial-gradient(ellipse 45% 40% at 96% 8%, rgb(88 105 76 / 0.35), transparent 52%);
    }

    @media (prefers-reduced-motion: no-preference) {
        .services-cta {
            animation: services-cta-pulse 2.6s ease-in-out infinite;
        }
    }

    @keyframes services-cta-pulse {
        0%,
        100% {
            box-shadow: 0 0 0 0 rgb(253 248 237 / 0.28);
        }
        50% {
            box-shadow: 0 0 0 10px rgb(253 248 237 / 0);
        }
    }
</style>

<script>
    import gsap from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    function initServices() {
        const root = document.querySelector("[data-services]");
        if (!(root instanceof HTMLElement) || root.dataset.ready === "true") return;

        const visual = root.querySelector("[data-services-visual]");
        const copy = root.querySelectorAll("[data-services-copy]");
        const cards = root.querySelectorAll("[data-services-card]");
        const cta = root.querySelector("[data-services-cta]");

        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
            root.dataset.ready = "true";
            return;
        }

        const setFrom = (dir: number) => {
            gsap.set(visual, { y: 40 * dir, opacity: 0, scale: 0.94 });
            gsap.set(copy, { y: 24 * dir, opacity: 0 });
            gsap.set(cards, { y: 24 * dir, opacity: 0 });
            gsap.set(cta, { y: 16 * dir, opacity: 0, scale: 0.8 });
        };

        const tl = gsap.timeline({
            paused: true,
            defaults: { ease: "power3.out" },
        });

        tl.to(visual, { y: 0, opacity: 1, scale: 1, duration: 0.9 }, 0)
            .to(copy, { y: 0, opacity: 1, duration: 0.7, stagger: 0.1 }, 0.18)
            .to(cards, { y: 0, opacity: 1, duration: 0.6, stagger: 0.08 }, 0.38)
            .to(
                cta,
                { y: 0, opacity: 1, scale: 1, duration: 0.5, ease: "back.out(1.7)" },
                0.42,
            );

        const play = (dir: number) => {
            tl.pause(0);
            setFrom(dir);
            tl.invalidate().restart();
        };

        setFrom(1);
        root.dataset.ready = "true";

        ScrollTrigger.create({
            trigger: root,
            start: "top 72%",
            end: "bottom top",
            onEnter: () => play(1),
            onEnterBack: () => play(-1),
            onLeave: () => tl.reverse(),
            onLeaveBack: () => tl.reverse(),
        });
    }

    initServices();
    document.addEventListener("astro:page-load", initServices);
</script>
